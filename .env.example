# =============================================================================
# FinSight - environment template
# Copy to .env and replace REPLACE_ME values for local dev.
# Never commit a real .env file. CI scans this repo for leaked secret patterns.
# =============================================================================

# ---- Execution mode ---------------------------------------------------------
# mock = use local stand-ins (DuckDB, Parquet sinks). live = real cloud.
EXECUTION_MODE=mock
ENVIRONMENT=local
LOG_LEVEL=INFO

# ---- AWS / S3 (mocked locally via MinIO) ------------------------------------
AWS_ACCESS_KEY_ID=minio_admin
AWS_SECRET_ACCESS_KEY=REPLACE_ME_minio_password
AWS_DEFAULT_REGION=us-east-1
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_BUCKET_BRONZE=finsight-bronze
AWS_S3_BUCKET_SILVER=finsight-silver

# ---- GCP / GCS (mocked locally via fake-gcs-server) -------------------------
GOOGLE_APPLICATION_CREDENTIALS=./config/.gcp-fake-sa.json
GCS_ENDPOINT_URL=http://localhost:4443
GCS_BUCKET_BRONZE=finsight-bronze-gcs
GCP_PROJECT_ID=finsight-local

# ---- Snowflake (live mode only) ---------------------------------------------
SNOWFLAKE_ACCOUNT=REPLACE_ME
SNOWFLAKE_USER=REPLACE_ME
SNOWFLAKE_PASSWORD=REPLACE_ME
SNOWFLAKE_ROLE=FINSIGHT_LOADER
SNOWFLAKE_WAREHOUSE=FINSIGHT_WH_XS
SNOWFLAKE_DATABASE=FINSIGHT
SNOWFLAKE_SCHEMA=GOLD

# ---- BigQuery (live mode only) ----------------------------------------------
BQ_PROJECT_ID=REPLACE_ME
BQ_DATASET_GOLD=finsight_gold
BQ_LOCATION=US

# ---- MS SQL Server (local container in mock, real server in live) -----------
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=REPLACE_ME_StrongP@ss1
MSSQL_DATABASE=FinSight
MSSQL_DRIVER=ODBC Driver 18 for SQL Server

# ---- Microsoft Fabric (live mode only) --------------------------------------
FABRIC_WORKSPACE_ID=REPLACE_ME
FABRIC_LAKEHOUSE_ID=REPLACE_ME
FABRIC_TENANT_ID=REPLACE_ME
FABRIC_CLIENT_ID=REPLACE_ME
FABRIC_CLIENT_SECRET=REPLACE_ME

# ---- Airflow ----------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=REPLACE_ME_generate_with_python_cryptography
AIRFLOW__WEBSERVER__SECRET_KEY=REPLACE_ME_random_string

# ---- Slack alerting (optional) ----------------------------------------------
SLACK_WEBHOOK_URL=REPLACE_ME_https://hooks.slack.com/services/...

# ---- OpenLineage (optional) -------------------------------------------------
OPENLINEAGE_URL=http://localhost:5000
OPENLINEAGE_NAMESPACE=finsight
